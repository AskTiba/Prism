generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id        String   @id @default(cuid())
  avatar    String?
  name      String
  category  String
  date      DateTime
  amount    Float
  recurring Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id       String   @id @default(cuid())
  category String   @unique
  maximum  Float
  theme    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pot {
  id       String   @id @default(cuid())
  name     String   @unique
  target   Float
  total    Float    @default(0)
  theme    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
